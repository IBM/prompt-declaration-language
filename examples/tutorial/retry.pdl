description: Retrying a block that fails intermittently
defs:
  attempts:
    lang: python
    code:
      |
      import itertools
      result = itertools.count(1)
text:
- lang: python
  code:
    |
    attempt = next(attempts)
    if attempt < 3:
        raise ConnectionError(f"attempt {attempt}: service unavailable")
    result = f"answered on attempt {attempt}"
  retry: 5
